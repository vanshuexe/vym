# Copy this file to .env and fill in real values. .env is git-ignored; never put real secrets in this file.
# Placeholder-looking values (your-..., change-this-..., replace-with-...) are ignored by the server.

# ---- Database: Supabase (Postgres) -------------------------------------------------------------
# Create the tables first: Supabase dashboard -> SQL Editor -> run supabase/schema.sql.
# Without SUPABASE_URL / SUPABASE_SECRET_KEY the server falls back to the local file cms-db.json.
# Dashboard -> Settings -> API Keys. The SECRET key stays on the server only.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SECRET_KEY="your-supabase-secret-key"
# Public (browser) values, used only by src/lib/supabase.ts
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-publishable-key"
# DB_BACKEND=json          # force the local JSON file even when Supabase is configured
# CMS_DB_PATH="cms-db.json"  # location of the JSON file when it is used

# ---- Payments: Razorpay ------------------------------------------------------------------------
# Dashboard -> Account & Settings -> API keys. Use rzp_test_ keys while developing.
VITE_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
# Signing secret from Razorpay Dashboard > Webhooks (events: payment.captured, order.paid -> /api/payment/webhook).
RAZORPAY_WEBHOOK_SECRET=""

# ---- Admin and sessions ------------------------------------------------------------------------
ADMIN_PASSWORD="change-this-admin-password"
# Must be its own long random value; never reuse a payment secret here.
JWT_SECRET="replace-with-a-long-random-secret"

# ---- Optional ----------------------------------------------------------------------------------
# APP_URL="https://your-site.example.com"   # where the app is hosted (callbacks, self-referential links)
# GEMINI_API_KEY="your-gemini-api-key"      # enables the AI chat assistant
# GEMINI_MODEL="gemini-flash-latest"
# SESSION_TIME_ZONE="Asia/Kolkata"          # time zone used to decide when a course session has ended
# TRUST_PROXY=1            # set when running behind a reverse proxy (Cloud Run, Nginx) so rate limits see client IPs
# PORT=8980
